# C compiled objects and executables (assuming subtrack.c compiles to binary)
*.o
*.out
*.exe
*.DS_Store

# Telemetry data (often generated dynamically or containing local logs)
SubTrack/telemetry.json
SubTrack/telemetry.js

# Local environment or temporary input files that shouldn't be tracked
SubTrack/input.json

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
